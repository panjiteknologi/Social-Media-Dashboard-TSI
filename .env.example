# =============================================================================
# Content Machine: server configuration
#
# Copy to .env and fill in. .env is gitignored; this template is not, so never
# put a real value here.
#
# Every variable below is read by the backend only. Do NOT prefix any of them
# with VITE_: Vite inlines VITE_* variables into the browser bundle, where
# anyone who opens the site can read them.
# =============================================================================

# --- App ---------------------------------------------------------------------
APP_BASE_URL=http://localhost:5173
API_PORT=8787
TIMEZONE=Asia/Jakarta
# In development, `npm run dev` starts a local Postgres that uses exactly this
# user, password, port and database, so the defaults just work. In production
# this points at the Postgres container.
DATABASE_URL=postgresql://content_machine:password@localhost:5432/content_machine

# Sign-in is by user list: only people added as users can log in (add more with
# `npm run cli -- user:add`). On first start with no users, this email becomes
# the first admin.
INITIAL_ADMIN_EMAIL=

# Google sign-in. In Google Cloud, set the authorised redirect URI to
#   {APP_BASE_URL}/api/auth/google/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Development only: enables /api/auth/dev-login, which signs this user in
# without Google. The server refuses to start in production when it is set.
# AUTH_DEV_LOGIN_EMAIL=

# Development only: show the design's sample numbers instead of the
# "not connected" states, to check layout.
# VITE_SAMPLE_DATA=true

# --- AI (OpenRouter) ---------------------------------------------------------
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Sent as attribution headers so usage shows up by app in the OpenRouter dashboard.
OPENROUTER_APP_NAME=Content Machine
OPENROUTER_APP_URL=
# Hard stop: the backend refuses new AI calls once this month's spend passes it.
AI_MONTHLY_BUDGET_USD=50

# Model per feature, swappable without a code change.
# Prices are USD per 1M input/output tokens on OpenRouter, checked 2026-09-13.

# Article drafts and "Generate Revision". $5 / $25
AI_MODEL_ARTICLE=anthropic/claude-opus-5
# QA before the Approval Queue: claims, brand rules, impartiality risks. $2 / $10
AI_MODEL_QA=anthropic/claude-sonnet-5
# Content briefs, topic recommendations, SEO opportunity reasoning. $2 / $10
AI_MODEL_STRATEGY=anthropic/claude-sonnet-5
# Instagram / Facebook / LinkedIn captions and hashtags. $2 / $10
AI_MODEL_SOCIAL=anthropic/claude-sonnet-5
# Narrative for daily / weekly / monthly reports. $2 / $10
AI_MODEL_REPORT=anthropic/claude-sonnet-5
# High-volume tagging: search intent, keyword clustering. $1 / $5
AI_MODEL_CLASSIFY=anthropic/claude-haiku-4.5
# Trend research that needs live web results with citations. $3 / $15 + per-search fee
AI_MODEL_RESEARCH=perplexity/sonar-pro
# Background imagery for flyers (text and logo are laid over it by a template). $0.50 / $3
AI_MODEL_IMAGE=google/gemini-3.1-flash-image

# --- Google: Search Console, GA4, PageSpeed ----------------------------------
# One service account serves both GSC and GA4. Keep the JSON under secrets/.
GOOGLE_SERVICE_ACCOUNT_JSON_PATH=./secrets/google-service-account.json
# Domain property form; use https://tsicertification.com/ for a URL-prefix property.
GSC_SITE_URL=sc-domain:tsicertification.com
# Numeric property id, not the G-XXXX measurement id.
GA4_PROPERTY_ID=
PAGESPEED_API_KEY=

# --- Keyword research (search volume, competitors, SERP) ---------------------
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# --- Website ------------------------------------------------------------------
# tsicertification.com is an Astro site on Vercel with its own custom CMS, not
# WordPress. Publishing variables get defined once that CMS's API is known
# (milestone M6 in docs/Build Plan and Status.md).
WEBSITE_BASE_URL=https://tsicertification.com

# The CMS database (Neon), read-only: articles and lead counts for the Articles
# and Analytics screens. Use the content_machine_reader role that
# `npm run cli -- cms:grant-sql` sets up, never the CMS's own DATABASE_URL: that
# one can change everything and read leads' contact details.
CMS_DATABASE_URL=

# --- Meta: Facebook Page + Instagram Business --------------------------------
META_APP_ID=
META_APP_SECRET=
# System User token from Meta Business Settings (does not expire like user tokens).
META_SYSTEM_USER_TOKEN=
META_PAGE_ID=
META_IG_BUSINESS_ACCOUNT_ID=

# --- LinkedIn Company Page: ON HOLD ------------------------------------------
# Leave blank for now. Plan and prerequisites: docs/Build Plan and Status.md
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_ORGANIZATION_ID=
LINKEDIN_REFRESH_TOKEN=

# --- Background jobs (scheduling, publishing, Workflow Logs) -----------------
# Built into the app, no n8n: jobs are queued in DATABASE_URL and run by a
# separate worker process. Schedules, on/off switches and retry limits live in
# Settings > Automation, not here.

# --- n8n: OPTIONAL, not part of any core flow --------------------------------
# Only if the team later wants its own side automations that call this app's
# API. Leave commented out otherwise.
# N8N_WEBHOOK_SECRET=

# --- Report delivery ---------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# WhatsApp Cloud API (official, via Meta): ON HOLD, Telegram is the only
# messaging channel for now. Leave blank. See docs/Build Plan and Status.md
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
# Comma-separated, international format without +, e.g. 6281234567890
WHATSAPP_RECIPIENTS=

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
REPORT_EMAIL_TO=

# --- Media storage (S3-compatible, e.g. Cloudflare R2) -----------------------
# Instagram publishing requires images at a public URL, so this is not optional
# once social publishing is on.
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=
